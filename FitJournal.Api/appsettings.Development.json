{
  "ConnectionStrings": {
    "FitJournalDb": "Server=<server>;Database=<database>;User ID=<user>;Password=<password>;TrustServerCertificate=True"
  },
  "Auth": {
    "Issuer": "<issuer>",
    "Audience": "<audience>",
    "Secret": "<secret-key>",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30
  },
  "Email": {
    "User": "<user>",
    "Password": "<password>",
    "MailBoxName": "<mail-box-name",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587
  },
  "ExternalAuth": {
    "FrontendUrl": "https://localhost:4200",
    "Google": { "ClientId": "<google-client-id>", "ClientSecret": "<google-client-secret>" },
    "Microsoft": { "ClientId": "<microsoft-client-id>", "ClientSecret": "<microsoft-client-secret>" }
  },
  "AzureStorage": { "ConnectionString": "<storage-connection-string>" }
  ,"AzureOpenAI": { "Endpoint": "<azure-openai-endpoint>", "Deployment": "<deployment-name>", "ApiKey": "<api-key>" }
}
